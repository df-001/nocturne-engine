LLM_MODEL=
LLM_VISION=true
ENABLE_TOOLS=true
MAX_TOOL_TURNS=10

#
# Additional Servers
#
IMG_URL=
STT_URL=
TTS_URL=

#
# Web Config
#
FIREBASE_PROJECT_ID="project-id-here"
API_PORT=3000
SQLITE_DB_NAME=web.db
CORS_ORIGINS=https://test.frontend.com,https://localhost:3000