# Config
DISCORD_BOT_ENABLED=true
WEB_API_ENABLED=true

#
# Base Config
#
TEMPERATURE=1.0
VOICE=
BREATH_ENABLED=true
MAX_TOKENS=4096
HISTORY_LIMIT=16

#
# Prompts
#
DM_PROMPT=
VOICE_PROMPT=
WEB_PROMPT=

#
# Discord Config
#
DISCORD_TOKEN=
CLIENT_ID=
STATUS="online" # "online" | "idle" | "dnd" | "invisible"
ACTIVITY=
BOT_CHANNEL_NAME=
